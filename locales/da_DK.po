msgid ""
""
"Single Logout service endpoint of the IdP. URL Location of the IdP where SLO "
"Request will be sent.OneLogin PHPSAML only supports the 'HTTP-redirect' "
"binding for this endpoint."
msgstr "Single Logout-serviceslutpunkt for IdP . URL Placering af IdP , hvor SLO -anmodningen vil blive sendt. OneLogin PHPSAML understøtter kun ' HTTP -redirect'-bindingen for dette slutpunkt."

#: src/Config/ConfigItem.php:279
msgid "SLO URL"
msgstr "SLO URL"

