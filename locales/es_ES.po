#: templates/configForm/general.html.twig:73
msgid "Domain & Button Configurations"
msgstr "Configuraciones de dominio y botones"

#: templates/configForm/general.html.twig:312
#, python-brace-format
msgid ""
""
""
"🔒 Userdomain is configured. Users can trigger a Saml Login by providing "
"their {username}@{userdomain} in the glpi username field and pressing the "
"login button. The password field is ignored and can be left blank. This is a "
"more secure option that wont expose configured IDPs."
msgstr "🔒 El dominio de usuario está configurado. Los usuarios pueden activar un inicio de sesión de Saml proporcionando su {username} @ {userdomain} en el campo de nombre de usuario de glpi y presionando el botón de inicio de sesión. El campo de contraseña se ignora y se puede dejar en blanco. Esta es una opción más segura que no expondrá a los IDP configurados."

