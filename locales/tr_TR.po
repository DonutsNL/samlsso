msgstr "SAML2 Kimlik Sağlayıcısı ( IdP ) tarafından sağlanan URL olan IdP varlığının tanımlayıcısı"

#: src/Config/ConfigItem.php:218
msgid "ENTITY ID"
msgstr "DÖNEM0DÖNEM"

#: src/Config/ConfigItem.php:223
msgid "⭕ Identity provider entity id is a required field"
msgstr "⭕ Kimlik sağlayıcı entity id zorunlu bir alandır"

#: src/Config/ConfigItem.php:237
