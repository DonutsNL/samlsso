msgstr "IdP - entiteetin tunniste , joka on SAML2 - identiteetin tarjoajan tarjoama URL ( IdP )"

#: src/Config/ConfigItem.php:218
msgid "ENTITY ID"
msgstr "ENTITY ID"

#: src/Config/ConfigItem.php:223
