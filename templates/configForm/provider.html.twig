{% import glpi_tpl_macro as fields %}
<div class="tab-pane fade d-none" id="provider" role="tabpanel" aria-labelledby="provider-tab">
    <div class="card-body">
        <div class="row">
            <div class="col-12 col-lg-6 mb-4">
                <!-- Group 1: Endpoints & Metadata -->
                <div class="samlsso-category-header">
                    <i class="fas fa-network-wired me-2 text-primary"></i>{{ __('Endpoints & Metadata', plugin) }}
                </div>
                <div class="samlsso-category-body">
                    <!-- Entity ID -->
                    <div class="mb-3">
                        {{ fields.textField(
                            'EntityID', 
                            entityID, 
                            __('Entity ID', plugin),
                            {
                                'id': 'EntityId',
                                'readonly':true,
                                'is_copyable': true,
                                helper: __('You need to configure the Entity ID at the identity provider. This value is crosschecked by the identity provider to make sure the sign-in request is originating from the correct service provider.', plugin),
                            }
                        ) }}
                    </div>

                    <!-- Meta URL -->
                    <div class="mb-3">
                        {% set metaUrl %}
                            <div class="btn-group btn-group-sm d-flex">
                                <input type="text" id="MetaUrl" class="form-control rounded-end-0" name="MetaUrl" value="{{ metaUrl }}" readonly="readonly">
                                {% if inputfields.debug.value == false %}
                                    {% set rand = random() %}
                                    <button type="button" id="meta_warning_{{ rand }}" class="btn btn-outline-secondary">
                                        <i class="ti ti-alert-triangle"></i>
                                    </button>
                                    {% do call('Html::showToolTip', [
                                        "Debug is disabled, metadata will only be exposed if 'debug' is enabled.",
                                        {'applyto': 'meta_warning_' ~ rand}
                                    ]) %}
                                {% endif %}
                                <button type="button" class="btn btn-outline-secondary" onclick="copyDisclosablePasswordFieldToClipboard('MetaUrl')">
                                    <i class="ti ti-clipboard-copy disclose"></i>
                                </button>
                            </div>
                        {% endset %}
                        {{ fields.field(
                            'MetaUrl', 
                            metaUrl, 
                            __('MetaUrl', plugin),
                            {
                                helper: __('The location of the metadata provider for this service provider (GLPI). The meta location can be used by the identity provider to collect important information from this service provider like what public certificate to use for signing and encrypting the SamlResponse.', plugin),
                            }
                        ) }}
                    </div>
                   
                    <!-- ACS url -->
                    <div class="mb-3">
                        {{ fields.textField(
                            'AcsUrl', 
                            acsUrl, 
                            __('AcsUrl', plugin),
                            {
                                'id': 'AcsUrl',
                                'readonly':true,
                                'is_copyable': true,
                                helper: __('The location of the Assertion Consumer Service (ACS) for this service provider (GLPI). This url is called by the identity provider after succesfull login.', plugin),
                            }
                        ) }}
                    </div>

                    <!-- Logout url -->
                    <div class="mb-3">
                        {{ fields.textField(
                            'SloUrl', 
                             sloUrl, 
                            __('SloUrl', plugin),
                            {
                                'id': 'SloUrl',
                                'readonly':true,
                                'is_copyable': true,
                                helper: __('The location where logout requests should be send back to from the Identity Provider.', plugin),
                            }
                        ) }}
                    </div>
                </div>

                <!-- Group 2: Name ID Policy -->
                <div class="samlsso-category-header">
                    <i class="fas fa-fingerprint me-2 text-primary"></i>{{ __('Name ID Policy', plugin) }}
                </div>
                <div class="samlsso-category-body">
                    <div class="mb-3">
                        {% set error_helper %}
                            {% if inputfields.sp_nameid_format.errors == true %}
                                <div id="textHelper" class="form-text" style="color:red;">{{ inputfields.sp_nameid_format.errors }}</div>
                            {% endif %}
                        {% endset %}

                        {{ fields.dropdownArrayField(
                            inputfields.sp_nameid_format.field,
                            inputfields.sp_nameid_format.value,
                            inputOptionsNameFormat,
                            inputfields.sp_nameid_format.formtitle,
                            {
                                'add_field_html': error_helper|raw,
                                helper: inputfields.sp_nameid_format.formexplain,
                            }
                        ) }}
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-6 mb-4">
                <!-- Group 3: Certificates & Keys -->
                <div class="samlsso-category-header d-flex justify-content-between align-items-center">
                    <div>
                        <i class="fas fa-key me-2 text-primary"></i>{{ __('Certificates & Keys', plugin) }}
                    </div>
                    {% if openssl_available %}
                        <button type="button" class="btn btn-sm btn-ghost-secondary" data-bs-toggle="modal" data-bs-target="#samlsso-cert-generator-modal" title="{{ __('Generate a new self-signed certificate and private key', plugin) }}">
                            <i class="ti ti-refresh me-1"></i>{{ __('Generate Keypair', plugin) }}
                        </button>
                    {% endif %}
                </div>
                <div class="samlsso-category-body">
                    {% if is_test_certificate and openssl_available %}
                        <div id="samlsso-cert-generator-banner" class="alert alert-warning d-flex align-items-center justify-content-between p-3 mb-3">
                            <div class="d-flex align-items-center">
                                <i class="ti ti-shield-alert text-warning fs-2 me-3"></i>
                                <div>
                                    <div class="fw-bold">{{ __('Default example certificate active', plugin) }}</div>
                                    <div class="text-muted small">
                                        {{ __('The example certificate (withlove.from.donuts.nl) offers no protection. Generate a new secure self-signed certificate and private key directly.', plugin) }}
                                    </div>
                                </div>
                            </div>
                            <button type="button" id="btn-generate-sp-cert" class="btn btn-warning btn-sm ms-3 text-nowrap" data-bs-toggle="modal" data-bs-target="#samlsso-cert-generator-modal">
                                <i class="ti ti-key me-1"></i>{{ __('Generate Certificate & Key', plugin) }}
                            </button>
                        </div>
                    {% endif %}

                    <!-- sp_certificate -->
                    <div class="mb-3">
                        {% set error_helper %}
                            {% if inputfields.sp_private_key.errors == true %}
                                <div id="textHelper" class="form-text" style="color:red;">{{ inputfields.sp_private_key.errors }}</div>
                            {% endif %}
                            {% if inputfields.sp_certificate.errors == true %}
                                <div id="textHelper" class="form-text" style="color:red;">{{ inputfields.sp_certificate.errors }}</div>
                            {% endif %}
                            {# make sure validate is an array/object before accessing nested keys #}
                            {% set sp_validate = inputfields.sp_certificate.validate|default({}) %}
                            {% if sp_validate.subject.CN|default(false) == true %}
                                <div id="textHelper" class="form-text" style="color:rgb(71, 180, 8);">🆗 Valid certificate found: {{ sp_validate.subject.CN|default('') }}</div>
                            {% endif %}
                            {% if sp_validate.validations.validTo|default(false) == true %}
                                <div id="textHelper" class="form-text" style="color:rgb(180, 120, 8);">{{ sp_validate.validations.validTo|default('') }}</div>
                            {% endif %}
                            {% if sp_validate.validations.validFrom|default(false) == true %}
                                <div id="textHelper" class="form-text" style="color:rgb(180, 120, 8);">{{ sp_validate.validations.validFrom|default('') }}</div>
                            {% endif %}
                        {% endset %}
                        
                        {{ fields.textareaField(
                            inputfields.sp_certificate.field,
                            inputfields.sp_certificate.value,
                            inputfields.sp_certificate.formtitle,
                            {
                                'add_field_html': error_helper|raw,
                                helper: inputfields.sp_certificate.formexplain,
                            }) 
                        }}
                    </div>

                    <!-- sp_private_key_source -->
                    <div class="mb-3">
                        {% if inputfields.sp_private_key_source.errors == true %}
                            <div id="textHelper" class="form-text" style="color:red;">{{ inputfields.sp_private_key_source.errors }}</div>
                        {% endif %}
                        {{ fields.dropdownArrayField(
                            inputfields.sp_private_key_source.field,
                            inputfields.sp_private_key_source.value,
                            inputOptionsKeySource,
                            inputfields.sp_private_key_source.formtitle,
                            {
                                helper: inputfields.sp_private_key_source.formexplain,
                            }) 
                        }}
                    </div>

                    {% set current_key_source = inputfields.sp_private_key_source.value|default('db') %}
                    {% set is_alt_source = current_key_source in ['file', 'env', 'define'] %}

                    {% set ref_label = __('SP Private Key File Path', plugin) %}
                    {% set ref_placeholder = '/etc/glpi/saml.key' %}
                    {% set ref_helper = __('Absolute path to the private key on the server filesystem. Must be outside the GLPI docroot and readable by the web server.', plugin) %}

                    {% if current_key_source == 'env' %}
                        {% set ref_label = __('Environment Variable Name', plugin) %}
                        {% set ref_placeholder = 'SAML_SP_PRIVATE_KEY' %}
                        {% set ref_helper = __('Name of the server environment variable containing the private key.', plugin) %}
                    {% elseif current_key_source == 'define' %}
                        {% set ref_label = __('PHP Constant Name', plugin) %}
                        {% set ref_placeholder = 'SAML_SP_KEY_CONSTANT' %}
                        {% set ref_helper = __('Name of the defined PHP constant containing the private key.', plugin) %}
                    {% endif %}

                    {% if inputfields.sp_private_key.errors is defined and inputfields.sp_private_key.errors %}
                        <div class="alert alert-warning d-flex align-items-center mb-3" role="alert">
                            <i class="ti ti-alert-triangle me-2"></i>
                            <div>{{ inputfields.sp_private_key.errors }}</div>
                        </div>
                    {% endif %}

                    <!-- sp_private_key alternative reference (file, env, define) -->
                    <div id="sp_private_key_ref_container" class="mb-3 {% if not is_alt_source %}d-none{% endif %}">
                        {{ fields.textField(
                            'sp_private_key',
                            is_alt_source ? inputfields.sp_private_key.value : '',
                            ref_label,
                            {
                                'id': 'sp_private_key_ref',
                                'disabled': not is_alt_source,
                                'placeholder': ref_placeholder,
                                helper: ref_helper,
                            }
                        ) }}
                        <div class="form-text text-muted mt-1">
                            <i class="ti ti-lock me-1"></i>{{ __('Database private key storage is disabled. The private key will be resolved dynamically at runtime.', plugin) }}
                        </div>
                    </div>

                    <!-- sp_private_key raw PEM textarea (db) -->
                    <div id="sp_private_key_raw_container" class="mb-3 {% if is_alt_source %}d-none{% endif %}">
                        {{ fields.textareaField( 
                            'sp_private_key',
                            '',
                            inputfields.sp_private_key.formtitle,
                            {
                                'id': 'sp_private_key_raw',
                                'disabled': is_alt_source,
                                'placeholder': has_stored_sp_key|default(false) ? __('Private key is stored encrypted in the database. Leave blank to keep the existing key, or paste a new PEM key to replace it.', plugin) : '',
                                helper: inputfields.sp_private_key.formexplain,
                            }) 
                        }}
                    </div>

                    <!-- Modal: SP Certificate Generation -->
                    {% if openssl_available %}
                    <div class="modal fade" id="samlsso-cert-generator-modal" tabindex="-1" role="dialog" aria-labelledby="samlsso-cert-generator-modal-title" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered" role="document">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="samlsso-cert-generator-modal-title">
                                        <i class="ti ti-certificate me-2 text-primary"></i>{{ __('Generate Service Provider Certificate', plugin) }}
                                    </h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ __('Close') }}"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="mb-3">
                                        <label class="form-label required" for="cert_gen_cn">{{ __('Common Name (CN)', plugin) }}</label>
                                        <input type="text" class="form-control" id="cert_gen_cn" value="{{ default_cert_cn }}" maxlength="64" required>
                                        <div class="form-text text-muted">{{ __('Subject Common Name for the certificate (e.g. your GLPI domain name).', plugin) }}</div>
                                    </div>
                                    <div class="row">
                                        <div class="col-12 col-md-6 mb-3">
                                            <label class="form-label required" for="cert_gen_type">{{ __('Cryptotype', plugin) }}</label>
                                            <select class="form-select" id="cert_gen_type">
                                                <option value="RSA" selected>RSA (SAML 2.0 Standard)</option>
                                                <option value="EC">ECDSA (Elliptic Curve)</option>
                                            </select>
                                            <div class="form-text text-muted">{{ __('SAML 2.0 IdPs primarily require RSA.', plugin) }}</div>
                                        </div>
                                        <div class="col-12 col-md-6 mb-3">
                                            <div id="cert_gen_rsa_container">
                                                <label class="form-label required" for="cert_gen_key_bits">{{ __('Key Length', plugin) }}</label>
                                                <select class="form-select" id="cert_gen_key_bits">
                                                    <option value="2048" selected>2048 bits (Standard)</option>
                                                    <option value="3072">3072 bits (High Security)</option>
                                                    <option value="4096">4096 bits (Maximum)</option>
                                                </select>
                                                <div class="form-text text-muted">{{ __('Key lengths below 2048 bits are disallowed.', plugin) }}</div>
                                            </div>
                                            <div id="cert_gen_ec_container" class="d-none">
                                                <label class="form-label required" for="cert_gen_curve">{{ __('Elliptic Curve', plugin) }}</label>
                                                <select class="form-select" id="cert_gen_curve">
                                                    <option value="prime256v1" selected>NIST P-256 (prime256v1)</option>
                                                    <option value="secp384r1">NIST P-384 (secp384r1)</option>
                                                    <option value="secp521r1">NIST P-521 (secp521r1)</option>
                                                </select>
                                                <div class="form-text text-muted">{{ __('NIST curves (minimum 256 bits).', plugin) }}</div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-12 col-md-6 mb-3">
                                            <label class="form-label required" for="cert_gen_valid_years">{{ __('Validity Period', plugin) }}</label>
                                            <select class="form-select" id="cert_gen_valid_years">
                                                <option value="1">1 {{ __('Year', plugin) }} (365 {{ __('Days', plugin) }})</option>
                                                <option value="2">2 {{ __('Years', plugin) }} (730 {{ __('Days', plugin) }})</option>
                                                <option value="3" selected>3 {{ __('Years', plugin) }} (1095 {{ __('Days', plugin) }})</option>
                                                <option value="5">5 {{ __('Years', plugin) }} (1825 {{ __('Days', plugin) }})</option>
                                                <option value="10">10 {{ __('Years', plugin) }} (3650 {{ __('Days', plugin) }})</option>
                                            </select>
                                            <div class="form-text text-muted">{{ __('Recommended validity is 3 years.', plugin) }}</div>
                                        </div>
                                        <div class="col-12 col-md-6 mb-3">
                                            <label class="form-label required" for="cert_gen_digest">{{ __('Signature Digest', plugin) }}</label>
                                            <select class="form-select" id="cert_gen_digest">
                                                <option value="sha256" selected>SHA-256 (Standard)</option>
                                                <option value="sha384">SHA-384</option>
                                                <option value="sha512">SHA-512</option>
                                            </select>
                                            <div class="form-text text-muted">{{ __('Cryptographic signature hash algorithm.', plugin) }}</div>
                                        </div>
                                    </div>
                                    <div id="cert_gen_error_box" class="alert alert-danger d-none py-2 px-3 mb-0"></div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                        {{ __('Cancel') }}
                                    </button>
                                    <button type="button" id="btn-confirm-generate-cert" class="btn btn-primary">
                                        <i class="ti ti-key me-1"></i>{{ __('Generate Certificate & Key', plugin) }}
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    {% endif %}

                    <script>
                    $(function() {
                        const keySourceMeta = {
                            file: {
                                label: '{{ __("SP Private Key File Path", plugin)|escape("js") }}',
                                placeholder: '/etc/glpi/saml.key',
                                helper: '{{ __("Absolute path to the private key on the server filesystem. Must be outside the GLPI docroot and readable by the web server.", plugin)|escape("js") }}'
                            },
                            env: {
                                label: '{{ __("Environment Variable Name", plugin)|escape("js") }}',
                                placeholder: 'SAML_SP_PRIVATE_KEY',
                                helper: '{{ __("Name of the server environment variable containing the private key.", plugin)|escape("js") }}'
                            },
                            define: {
                                label: '{{ __("PHP Constant Name", plugin)|escape("js") }}',
                                placeholder: 'SAML_SP_KEY_CONSTANT',
                                helper: '{{ __("Name of the defined PHP constant containing the private key.", plugin)|escape("js") }}'
                            }
                        };

                        function updateKeySourceUI(source) {
                            const $refContainer = $('#sp_private_key_ref_container');
                            const $rawContainer = $('#sp_private_key_raw_container');
                            const $refInput = $('#sp_private_key_ref');
                            const $rawTextarea = $('#sp_private_key_raw');

                            if (source === 'db') {
                                $refContainer.addClass('d-none');
                                $refInput.prop('disabled', true);
                                $rawContainer.removeClass('d-none');
                                $rawTextarea.prop('disabled', false);
                            } else if (keySourceMeta[source]) {
                                $rawContainer.addClass('d-none');
                                $rawTextarea.prop('disabled', true);
                                $refContainer.removeClass('d-none');
                                $refInput.prop('disabled', false);

                                const meta = keySourceMeta[source];
                                $refInput.attr('placeholder', meta.placeholder);

                                const $label = $refContainer.find('label.col-form-label');
                                if ($label.length) {
                                    const $help = $label.find('.form-help');
                                    if ($help.length) {
                                        $label.contents().filter(function() {
                                            return this.nodeType === 3;
                                        }).first().replaceWith(meta.label + ' ');
                                        $help.attr('data-bs-title', meta.helper);
                                        $help.attr('aria-label', meta.helper);
                                        if (typeof bootstrap !== 'undefined' && bootstrap.Tooltip) {
                                            const inst = bootstrap.Tooltip.getInstance($help[0]);
                                            if (inst && typeof inst.setContent === 'function') {
                                                inst.setContent({ '.tooltip-inner': meta.helper });
                                            }
                                        }
                                    } else {
                                        $label.text(meta.label);
                                    }
                                }
                            }
                        }

                        $(document).on('change', 'select[name="sp_private_key_source"]', function() {
                            updateKeySourceUI($(this).val());
                        });

                        $(document).on('change', '#cert_gen_type', function() {
                            const isEc = $(this).val() === 'EC';
                            $('#cert_gen_rsa_container').toggleClass('d-none', isEc);
                            $('#cert_gen_ec_container').toggleClass('d-none', !isEc);
                        });

                        $(document).on('click', '#btn-confirm-generate-cert', function(e) {
                            e.preventDefault();
                            const $btn = $(this);
                            const origHtml = $btn.html();
                            const $errorBox = $('#cert_gen_error_box');
                            $errorBox.addClass('d-none').text('');

                            const cnVal = ($('#cert_gen_cn').val() || '').trim();
                            if (!cnVal) {
                                $errorBox.removeClass('d-none').text('{{ __("Common Name (CN) is required.", plugin)|escape("js") }}');
                                return;
                            }

                            $btn.prop('disabled', true).html('<i class="ti ti-loader animate-spin me-1"></i>{{ __("Generating...", plugin)|escape("js") }}');

                            $.ajax({
                                url: '{{ glpi_rootdoc }}',
                                type: 'POST',
                                dataType: 'json',
                                data: {
                                    action: 'generate_cert',
                                    _glpi_csrf_token: '{{ csrf_token }}',
                                    id: '{{ inputfields.id.value|default(-1) }}',
                                    common_name: cnVal,
                                    key_type: $('#cert_gen_type').val(),
                                    key_bits: $('#cert_gen_key_bits').val(),
                                    curve_name: $('#cert_gen_curve').val(),
                                    valid_years: $('#cert_gen_valid_years').val(),
                                    digest_alg: $('#cert_gen_digest').val()
                                },
                                success: function(response) {
                                    if (response && response.success) {
                                        $('textarea[name="sp_certificate"]').val(response.certificate);
                                        const $keySourceSelect = $('select[name="sp_private_key_source"]');
                                        if ($keySourceSelect.length) {
                                            $keySourceSelect.val('db').trigger('change');
                                        }
                                        $('#sp_private_key_raw').val(response.private_key);

                                        const modalEl = document.getElementById('samlsso-cert-generator-modal');
                                        if (modalEl && typeof bootstrap !== 'undefined' && bootstrap.Modal) {
                                            const modalInst = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                                            modalInst.hide();
                                        }

                                        $('#samlsso-cert-generator-banner').removeClass('alert-warning').addClass('alert-success').html(
                                            '<div class="d-flex align-items-center">' +
                                                '<i class="ti ti-check text-success fs-2 me-3"></i>' +
                                                '<div>' +
                                                    '<div class="fw-bold">{{ __("New certificate and private key generated", plugin)|escape("js") }}</div>' +
                                                    '<div class="text-muted small">' +
                                                        '{{ __("Review the generated certificate and private key below, then click Save to apply changes.", plugin)|escape("js") }}' +
                                                    '</div>' +
                                                '</div>' +
                                            '</div>'
                                        );
                                    } else {
                                        $errorBox.removeClass('d-none').text(response && response.error ? response.error : '{{ __("Failed to generate certificate.", plugin)|escape("js") }}');
                                    }
                                    $btn.prop('disabled', false).html(origHtml);
                                },
                                error: function(xhr) {
                                    let err = '{{ __("Failed to generate certificate.", plugin)|escape("js") }}';
                                    if (xhr.responseJSON && xhr.responseJSON.error) {
                                        err = xhr.responseJSON.error;
                                    }
                                    $errorBox.removeClass('d-none').text(err);
                                    $btn.prop('disabled', false).html(origHtml);
                                }
                            });
                        });
                    });
                    </script>
                </div>
            </div>
        </div>
    </div>
</div>
